[Unit]
Description=R1 ↔ Hermes Bridge — Rabbit R1 WebSocket Gateway
After=network-online.target hermes-gateway.service
Wants=network-online.target

[Service]
Type=simple
ExecStart=/home/vitrus/.hermes/hermes-agent/venv/bin/python3 /home/vitrus/r1-hermes-bridge/server.py
WorkingDirectory=/home/vitrus/r1-hermes-bridge
Restart=on-failure
RestartSec=5
Environment=PYTHONUNBUFFERED=1
Environment=HERMES_API_URL=http://127.0.0.1:8642/v1
Environment=R1_BRIDGE_PORT=18790
Environment=HOME=/home/vitrus

# Read auth token from file (generated by setup.sh)
EnvironmentFile=-/home/vitrus/r1-hermes-bridge/.r1-bridge-env

# Security hardening
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/home/vitrus/r1-hermes-bridge
ReadOnlyPaths=/home/vitrus/.hermes/.env

[Install]
WantedBy=default.target
